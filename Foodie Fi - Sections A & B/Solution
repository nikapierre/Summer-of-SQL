--Q1) How many customers has Foodie-Fi ever had?
SELECT
COUNT(distinct customer_id)
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id;

--Q2) What is the monthly distribution of trial plan start_date values for our dataset - use the start of the month as the group by value
SELECT
COUNT(distinct customer_id)
, DATE_TRUNC('month',START_DATE) as MONTH
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id
WHERE P.PLAN_NAME='trial'
GROUP BY 2;

-- Q3) What plan start_date values occur after the year 2020 for our dataset? Show the breakdown by count of events for each plan_name
SELECT
COUNT(distinct customer_id)
, plan_name
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id
WHERE YEAR(START_DATE)>2020
GROUP BY 2;

-- Q4) What is the customer count and percentage of customers who have churned rounded to 1 decimal place?
WITH C_COUNT AS(
SELECT
COUNT(distinct customer_id) as TOTAL_CUSTOMERS
FROM SUBSCRIPTIONS
)
SELECT
COUNT(distinct customer_id) as Churned_CUSTOMERS
,C.TOTAL_CUSTOMERS
, ROUND((Churned_CUSTOMERS/C.TOTAL_CUSTOMERS)*100,1) as CHURNED_PERCENTAGE
FROM SUBSCRIPTIONS, C_COUNT C
WHERE PLAN_ID=4
group by all;

--Q5) How many customers have churned straight after their initial free trial - what percentage is this rounded to the nearest whole number?
--Total Customers
WITH TC AS (
SELECT
COUNT(distinct CUSTOMER_ID) as TOTAL_CUSTOMERS
FROM SUBSCRIPTIONS 
)
--List of Trial Dates
,TRIAL_ as (
SELECT
CUSTOMER_ID
,START_DATE as TRIAL_DATE
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id
WHERE plan_name='trial'
)
--list of churned dates
, CTE AS(SELECT
S.CUSTOMER_ID
,T.TRIAL_DATE
,S.START_DATE as CHURN_DATE
,DATEDIFF('days',T.TRIAL_DATE, S.START_DATE) as DAY_DIFF
FROM SUBSCRIPTIONS S
JOIN TRIAL_ T
ON S.CUSTOMER_ID=T.CUSTOMER_ID
WHERE plan_id=4
ORDER BY DAY_DIFF asc
)
SELECT
COUNT(CUSTOMER_ID) as Customers_Churned_After_Trial
,ROUND((COUNT(CUSTOMER_ID) * 100.0 / MIN(TC.TOTAL_CUSTOMERS)), 1) AS PERCENTAGE_CHURNED_AFTER_TRIAL
FROM CTE, TC 
WHERE DAY_DIFF=7;

--Q6)What is the number and percentage of customer plans after their initial free trial?
--Assign Numbers, for each customers plan journey. eg 1 =trial always
WITH NUM1 AS (
SELECT
*,
ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY start_date ASC) as Plan_Journey
FROM SUBSCRIPTIONS S
JOIN PLANS P 
ON P.plan_id = S.plan_id
)
--Total Customers
, TC AS (
SELECT
COUNT(distinct CUSTOMER_ID) as TOTAL_CUSTOMERS
FROM SUBSCRIPTIONS 
)
SELECT 
plan_name
,COUNT(customer_id) as NUMBER_OF_CUSTOMERS
,ROUND((COUNT(CUSTOMER_ID) * 100.0 / MIN(TC.TOTAL_CUSTOMERS)), 1) AS PERCENTAGE
FROM NUM1, TC
WHERE Plan_Journey = 2
GROUP BY all;

--Q7)What is the customer count and percentage breakdown of all 5 plan_name values at 2020-12-31?
--Total Customers on specific date
WITH NUM1 AS (
SELECT*
,ROW_NUMBER() OVER(PARTITION BY customer_id ORDER BY start_date DESC) as Plan_Journey
FROM SUBSCRIPTIONS S
JOIN PLANS P 
ON P.plan_id = S.plan_id
WHERE START_DATE<='2020-12-31'
)
, TC AS (
SELECT
COUNT(distinct CUSTOMER_ID) as TOTAL_CUSTOMERS
FROM NUM1
WHERE START_DATE<='2020-12-31'
AND Plan_Journey=1
)
SELECT
N.Plan_Name
,COUNT(distinct CUSTOMER_ID) as CUSTOMERS
,ROUND (COUNT(distinct CUSTOMER_ID)*100/ MIN(TC.TOTAL_CUSTOMERS),1) as PERCENTAGE
FROM NUM1 N, TC
WHERE Plan_Journey=1
GROUP BY all;

