--Q9) How many days on average does it take for a customer to an annual plan from the day they join Foodie-Fi?
--List of Trial Dates
WITH TRIAL_ as (
SELECT
CUSTOMER_ID
,PLAN_NAME
,START_DATE as TRIAL_DATE
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id
WHERE plan_name='trial'
)
--list of annual plan dates
, ANNUAL_ AS(
SELECT
CUSTOMER_ID
,PLAN_NAME
,START_DATE as ANNUAL_DATE
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id
WHERE plan_name='pro annual'
)
SELECT
A.CUSTOMER_ID
,TRIAL_DATE
,ANNUAL_DATE
,DATEDIFF('days',TRIAL_DATE,ANNUAL_DATE) as Days_between_conversion
,ROUND(AVG(DATEDIFF('days', TRIAL_DATE, ANNUAL_DATE)) OVER(),0) AS Overall_Avg_Days
FROM TRIAL_ T
JOIN ANNUAL_ A
ON T.CUSTOMER_ID=A.CUSTOMER_ID
group by 1,2,3;

-- Q10) Can you further breakdown this average value into 30 day periods (i.e. 0-30 days, 31-60 days etc)
WITH TRIAL_ as (
SELECT
CUSTOMER_ID
,PLAN_NAME
,START_DATE as TRIAL_DATE
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id
WHERE plan_name='trial'
)
--list of annual plan dates
, ANNUAL_ AS(
SELECT
CUSTOMER_ID
,PLAN_NAME
,START_DATE as ANNUAL_DATE
FROM SUBSCRIPTIONS S
JOIN PLANS P
ON S.plan_id=P.Plan_id
WHERE plan_name='pro annual'
)
SELECT
A.CUSTOMER_ID
,TRIAL_DATE
,ANNUAL_DATE
,DATEDIFF('days',TRIAL_DATE,ANNUAL_DATE) as Days_between_conversion

,CASE 
      WHEN DATEDIFF('days',TRIAL_DATE,ANNUAL_DATE) < 30 THEN'0-30 days'
      WHEN DATEDIFF('days',TRIAL_DATE,ANNUAL_DATE) BETWEEN 30 AND 60 THEN '30-60 days'
      ELSE '> 60 days'
    END AS CONVERSION_BAND
,ROUND(AVG(DATEDIFF('days', TRIAL_DATE, ANNUAL_DATE)) OVER(),0) AS Overall_Avg_Days
FROM TRIAL_ T
JOIN ANNUAL_ A
ON T.CUSTOMER_ID=A.CUSTOMER_ID
group by 1,2,3;

