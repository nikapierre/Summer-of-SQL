--TRANSACTION PATH 
WITH TRANS_PATH AS (
SELECT
TRANSACTION_ID
,ACCOUNT_TO 
,ACCOUNT_FROM 
FROM PD2023_WK07_TRANSACTION_PATH
)

--ACCOUNT INFORMATION TABLE
, ACCOUNT_INFO_PRE_PIV AS (
SELECT
ACCOUNT_NUMBER
,ACCOUNT_TYPE
,SPLIT_PART(ACCOUNT_HOLDER_ID,',',1) as ACCOUNT_HOLDER_ID_1
,SPLIT_PART(ACCOUNT_HOLDER_ID,',',2) as ACCOUNT_HOLDER_ID_2
,balance_date
,balance
FROM PD2023_WK07_ACCOUNT_INFORMATION
)
,PIV AS(
SELECT
ACCOUNT_NUMBER
,ACCOUNT_TYPE
,ACCOUNT_HOLDER_ID
,balance_date
,balance
FROM ACCOUNT_INFO_PRE_PIV
UNPIVOT(ACCOUNT_HOLDER_ID FOR ID_ IN (ACCOUNT_HOLDER_ID_1, ACCOUNT_HOLDER_ID_2))
)
, ACCOUNT_INFO AS (
SELECT
ACCOUNT_NUMBER
,ACCOUNT_TYPE
,ACCOUNT_HOLDER_ID
,balance_date
,balance
FROM PIV
WHERE ACCOUNT_HOLDER_ID not like ''
)

--ACCOUNT HOLDERS
, ACCOUNT_HOLDERS AS(
SELECT 
ACCOUNT_HOLDER_ID
,NAME
,DATE_OF_BIRTH
, '0'|| TO_VARCHAR(CONTACT_NUMBER) as CONTACT_NUMBER
,FIRST_LINE_OF_ADDRESS
FROM PD2023_WK07_ACCOUNT_HOLDERS
)
--FINAL JOIN
SELECT
TP.TRANSACTION_ID as "TRANSACTION ID"
,TP.ACCOUNT_TO as "ACCOUNT TO" 
,TD.VALUE
,AI.ACCOUNT_NUMBER as "ACCOUNT NUMBER"
,AI.ACCOUNT_TYPE as "ACCOUNT TYPE"
,AI.balance_date as "BALANCE DATE"
,AI.balance
,AH.NAME
,AH.DATE_OF_BIRTH as "DATE OF BIRTH"
,AH.CONTACT_NUMBER as "CONTACT NUMBER"
,AH.FIRST_LINE_OF_ADDRESS as "FIRST LINE OF ADDRESS"
FROM TRANS_PATH TP
JOIN PD2023_WK07_TRANSACTION_DETAIL TD
ON TP.TRANSACTION_ID = TD.TRANSACTION_ID
LEFT JOIN ACCOUNT_INFO AI
ON TP.ACCOUNT_FROM=AI.ACCOUNT_NUMBER
LEFT JOIN ACCOUNT_HOLDERS AH
ON AI.ACCOUNT_HOLDER_ID= AH.ACCOUNT_HOLDER_ID
WHERE TD.CANCELLED_='N'
AND TD.VALUE>1000
AND AI.ACCOUNT_TYPE not like 'Platinum' ;