--UNPIVIOT MOBILE CATEGORY RATINGS
WITH MB_RATINGS AS (
SELECT 
CUSTOMER_ID
,CATEGORY
, MOBILE_APP_Rate
FROM PD2023_WK06_DSB_CUSTOMER_SURVEY
UNPIVOT(MOBILE_APP_Rate FOR CATEGORY IN (MOBILE_APP___EASE_OF_USE as EASE_OF_USE , MOBILE_APP___EASE_OF_ACCESS as EASE_OF_ACCESS, MOBILE_APP___NAVIGATION as NAVIGATION, MOBILE_APP___LIKELIHOOD_TO_RECOMMEND as LIKELIHOOD_TO_RECOMMEND, MOBILE_APP___OVERALL_RATING as OVERALL_RATING)
)
                    )
--UNPIVIOT ONLINE_INTERFACE RATINGS
,OI_RATING AS(
SELECT 
CUSTOMER_ID
,CATEGORY
,ONLINE_INTERFACE_RATE
FROM PD2023_WK06_DSB_CUSTOMER_SURVEY
UNPIVOT (ONLINE_INTERFACE_RATE FOR CATEGORY IN (ONLINE_INTERFACE___EASE_OF_USE as EASE_OF_USE, ONLINE_INTERFACE___EASE_OF_ACCESS as EASE_OF_ACCESS, ONLINE_INTERFACE___NAVIGATION as NAVIGATION, ONLINE_INTERFACE___LIKELIHOOD_TO_RECOMMEND as LIKELIHOOD_TO_RECOMMEND, ONLINE_INTERFACE___OVERALL_RATING as OVERALL_RATING)
 )
            )
-- Create Avg Ratings, Avg Rating Difference and Preference Categories
,PREF AS(
SELECT
OI.CUSTOMER_ID
,OI.CATEGORY
, MOBILE_APP_Rate
,ONLINE_INTERFACE_RATE
,ROUND(AVG(MOBILE_APP_Rate) OVER (PARTITION BY OI.CUSTOMER_ID),2) as AVG_MOBILE_APP_RATING
,ROUND(AVG(ONLINE_INTERFACE_RATE) OVER (PARTITION BY OI.CUSTOMER_ID),2) as AVG_ONLINE_INTERFACE_APP_RATING
,ROUND(AVG(MOBILE_APP_Rate) OVER (PARTITION BY OI.CUSTOMER_ID),2)-ROUND(AVG(ONLINE_INTERFACE_RATE) OVER (PARTITION BY OI.CUSTOMER_ID),2) as AVG_DIFFERENCE
,CASE
    WHEN ROUND(AVG(MOBILE_APP_Rate) OVER (PARTITION BY OI.CUSTOMER_ID),2)-ROUND(AVG(ONLINE_INTERFACE_RATE) OVER (PARTITION BY OI.CUSTOMER_ID),2)> =2 THEN 'Mobile App Superfan'
    WHEN ROUND(AVG(MOBILE_APP_Rate) OVER (PARTITION BY OI.CUSTOMER_ID),2)-ROUND(AVG(ONLINE_INTERFACE_RATE) OVER (PARTITION BY OI.CUSTOMER_ID),2) >= 1 THEN 'Mobile App Fans'
        WHEN ROUND(AVG(MOBILE_APP_Rate) OVER (PARTITION BY OI.CUSTOMER_ID),2)-ROUND(AVG(ONLINE_INTERFACE_RATE) OVER (PARTITION BY OI.CUSTOMER_ID),2) <=-2 THEN 'Online Interface SuperFan'
    WHEN ROUND(AVG(MOBILE_APP_Rate) OVER (PARTITION BY OI.CUSTOMER_ID),2)-ROUND(AVG(ONLINE_INTERFACE_RATE) OVER (PARTITION BY OI.CUSTOMER_ID),2) <= -1  THEN 'Online Interface Fan'

    ELSE 'Neutral'
    END as Preference
FROM MB_RATINGS MB
JOIN OI_RATING OI
ON MB.CUSTOMER_ID=OI.CUSTOMER_ID
AND MB.CATEGORY=OI.CATEGORY
WHERE OI.CATEGORY NOT LIKE 'OVERALL_RATING'
ORDER BY AVG_DIFFERENCE DESC
)
--Aggregate to final view
SELECT
Preference
,COUNT(distinct CUSTOMER_ID) as CUSTOMER_COUNT
,ROUND(COUNT(distinct CUSTOMER_ID)*100/(SELECT COUNT(distinct CUSTOMER_ID)FROM PREF),1) as "% of Total"
FROM PREF
group by all;